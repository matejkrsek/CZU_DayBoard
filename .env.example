# DayBoard – konfigurace
# Zkopírujte tento soubor jako ".env" a doplňte hodnoty. Soubor .env se necommituje.
# Bez souboru .env aplikace běží s výchozími hodnotami a ukázkovými daty.

# development = chyby se vypisují do prohlížeče, production = jen do storage/logs
APP_ENV=development

# Veřejná adresa webu bez lomítka na konci, např. https://dayboard.example.cz
# Používá se pro canonical, sitemap.xml a návratovou adresu Google OAuth.
# Prázdné = adresa se odvodí z příchozího požadavku.
APP_URL=

# Ukázkový režim: na přihlašovací stránce nabídne ukázkové účty a widgety bez
# nastaveného API klíče zobrazí ukázková data. V ostrém provozu nastavte false.
DEMO_MODE=true

# Cesta k SQLite databázi (relativně ke kořeni projektu, nebo absolutní)
DB_PATH=storage/dayboard.sqlite

# Google Kalendář (widget Dnešní program) – OAuth 2.0 klient typu "Webová aplikace"
# Autorizovaný redirect URI: {APP_URL}/nastaveni/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TomTom Routing + Geocoding API (widget Doprava autem) – https://developer.tomtom.com
TOMTOM_API_KEY=

# Golemio API (widget Odjezdy MHD) – https://api.golemio.cz/api-keys
GOLEMIO_API_KEY=
